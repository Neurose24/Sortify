generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ================================
// ENUM
// ================================

enum UserRole {
  ADMIN
  PETUGAS
  SELLER
}

enum PackageScanStatus {
  BELUM_DISCAN
  SUDAH_DISCAN
}

enum PackageCondition {
  NORMAL
  PENDING
  BATAL
  DUPLIKAT
  PREFIX_TIDAK_DIKENAL
}

enum SecurityStatus {
  TIDAK_PERLU
  PERLU_DIAMANKAN
  SUDAH_DIAMANKAN
}

enum ScanResult {
  BERHASIL
  BARCODE_TIDAK_DIKENAL
  PREFIX_TIDAK_DIKENAL
  SUDAH_PERNAH_DISCAN
  PAKET_PENDING
  PAKET_BATAL
  PAKET_DUPLIKAT
  GAGAL
}

// ================================
// USERS
// ================================

model User {
  id        String   @id @default(cuid())
  nama      String
  username  String   @unique
  password  String
  role      UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  managedStores Store[]       @relation("SellerStores")
  packages      Package[]     @relation("PackageCreatedBy")
  scanHistories ScanHistory[]

  @@map("users")
}

// ================================
// MARKETPLACES
// ================================

model Marketplace {
  id        String   @id @default(cuid())
  nama      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stores Store[]

  @@map("marketplaces")
}

// ================================
// STORES
// ================================

model Store {
  id            String   @id @default(cuid())
  marketplaceId String
  sellerId      String
  nama          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  marketplace Marketplace @relation(fields: [marketplaceId], references: [id], onDelete: Restrict)
  seller      User        @relation("SellerStores", fields: [sellerId], references: [id], onDelete: Restrict)
  packages    Package[]

  @@unique([marketplaceId, nama])
  @@index([sellerId])
  @@map("stores")
}

// ================================
// EXPEDITIONS
// ================================

model Expedition {
  id        String   @id @default(cuid())
  nama      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prefixRules PrefixRule[]
  packages    Package[]

  @@map("expeditions")
}

// ================================
// PREFIX RULES
// ================================

model PrefixRule {
  id           String   @id @default(cuid())
  expeditionId String
  awalan       String?
  akhiran      String?
  panjang      Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  expedition Expedition @relation(fields: [expeditionId], references: [id], onDelete: Cascade)

  @@index([expeditionId])
  @@map("prefix_rules")
}

// ================================
// PACKAGES
// ================================

model Package {
  id               String            @id @default(cuid())
  storeId          String
  expeditionId     String?
  createdById      String?
  nomorPesanan     String
  barcode          String?           @unique
  statusScan       PackageScanStatus @default(BELUM_DISCAN)
  statusPaket      PackageCondition  @default(NORMAL)
  statusPengamanan SecurityStatus    @default(TIDAK_PERLU)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  store      Store       @relation(fields: [storeId], references: [id], onDelete: Restrict)
  expedition Expedition? @relation(fields: [expeditionId], references: [id], onDelete: SetNull)
  createdBy  User?       @relation("PackageCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  scanHistories ScanHistory[]

  @@unique([storeId, nomorPesanan])
  @@index([expeditionId])
  @@index([statusScan])
  @@index([statusPaket])
  @@index([statusPengamanan])
  @@map("packages")
}

// ================================
// SCAN HISTORIES
// ================================

model ScanHistory {
  id               String            @id @default(cuid())
  packageId        String?
  userId           String
  barcode          String
  hasilScan        ScanResult
  statusPaket      PackageCondition?
  statusPengamanan SecurityStatus?
  keterangan       String?
  scannedAt        DateTime          @default(now())

  package Package? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([packageId])
  @@index([userId])
  @@index([barcode])
  @@index([scannedAt])
  @@map("scan_histories")
}
